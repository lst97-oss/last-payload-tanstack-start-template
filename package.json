{
  "name": "payload-tanstack-start-template",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#vendor/*": "./vendor/*"
  },
  "scripts": {
    "dev": "bunx --bun vite dev --port 3000",
    "build": "bun run generate:payload-admin-css && bun run generate:types && bun run generate:importmap && bunx --bun vite build",
    "start": "bun .output/server/index.mjs",
    "payload": "bunx payload",
    "generate:types": "bunx ${PAYLOAD_BUNX_FLAGS:-} payload ${PAYLOAD_CLI_ARGS:-} generate:types",
    "generate:importmap": "bunx ${PAYLOAD_BUNX_FLAGS:-} payload ${PAYLOAD_CLI_ARGS:-} generate:importmap",
    "db:migrate": "bunx payload migrate",
    "typecheck": "bun check",
    "generate:payload-admin-css": "bun run scripts/assets/generate-payload-admin-css.ts",
    "generate-routes": "tsr generate"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-canary.37",
    "@payloadcms/drizzle": "4.0.0-canary.37",
    "@payloadcms/richtext-lexical": "4.0.0-canary.37",
    "@payloadcms/tanstack-start": "4.0.0-canary.37",
    "@payloadcms/translations": "4.0.0-canary.37",
    "@payloadcms/ui": "4.0.0-canary.37",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "payload": "4.0.0-canary.37",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "bun-types": "^1.4.3",
    "nitro": "^3.0.260903-beta",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
