PAYLOAD_SECRET=
DATABASE_URL=
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Logging. The same three settings as every service in this repo family (see src/server/observability/logger-settings.ts).
#   LOG_LEVEL=debug|info|warn|error  default info
#   LOG_FORMAT=auto|pretty|json      default auto: pretty on a terminal, json otherwise (containers, log shippers)
#   LOG_COLOR=auto|always|never      default auto: colour on a terminal; NO_COLOR turns it off
LOG_LEVEL=info
LOG_FORMAT=auto
LOG_COLOR=auto
